{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build:types"]
    },
    "test": {
      "dependsOn": ["^build:types"]
    },
    "build:types": {
      "outputs": ["dist/types/**", "worker-configuration.d.ts"]
    }
  }
}
